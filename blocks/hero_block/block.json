{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "midflight/hero-block",
    "title": "Page Hero (Full Width)",
    "textdomain": "kiwatinook",
    "description": "Full-bleed hero section with background image, optional brand hoop overlay, and nested child blocks.",
    "category": "widgets",
    "icon": "cover-image",
    "keywords": ["hero", "banner", "full width", "home", "cover"],
    "supports": {
        "align": ["full"],
        "anchor": true,
        "customClassName": true,
        "html": false
    },
    "render": "file:./hero_block.php",
    "editorScript": "file:./index.js",
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        },
        "backgroundImage": {
            "type": "object",
            "properties": {
                "id":  { "type": "number" },
                "url": { "type": "string" },
                "alt": { "type": "string" }
            }
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "showHoopOverlay": {
            "type": "boolean",
            "default": true
        },
        "overlayOpacity": {
            "type": "number",
            "default": 25
        },
        "overlayColor": {
            "type": "string",
            "default": "#000000"
        },
        "textColor": {
            "type": "string",
            "default": "#ffffff"
        },
        "minHeight": {
            "type": "number",
            "default": 60
        },
        "contentAlignment": {
            "type": "string",
            "default": "center"
        },
        "verticalAlignment": {
            "type": "string",
            "default": "middle"
        }
    }
}
